# Canonical public URL. Set this to the final production domain.
NEXT_PUBLIC_SITE_URL=https://dreamweaversoffice.com

# Keep false for local and preview deployments. Set true only in Vercel Production.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional comma-separated HTTPS social profile URLs for Organization JSON-LD.
NEXT_PUBLIC_SOCIAL_URLS=

# Optional search-engine ownership verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional same-origin or HTTPS endpoint that receives Core Web Vitals JSON.
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=

# Optional: skip the cinematic intro. The intro already runs once per browser session.
NEXT_PUBLIC_DISABLE_INTRO=false

# Server-only contact delivery configuration.
CONTACT_WEBHOOK_URL=
CONTACT_ALLOWED_ORIGINS=https://dreamweaversoffice.com
